<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true"
    tools:context=".ui.pelayanan.PendaftaranPelayananPemanfaatanDataFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pendaftaran"
            android:textColor="#1565C0"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/surat_pelayanan_pemanfaatan_data"
            android:textColor="#212121"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/lengkapi"
            android:textColor="#757575"
            android:textSize="14sp" />


        <!-- ============================= -->
        <!-- DATA INSTANSI -->
        <!-- ============================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/data_instansi"
                    android:textColor="#424242"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Nama Instansi -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:hint="@string/nama_instansi">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtNamaInstansi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- Jenis Instansi -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:hint="@string/jenis_instansi">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtJenisInstansi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- Alamat Instansi -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:hint="@string/alamat_instansi">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtAlamatInstansi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lines="3"
                        android:gravity="top"
                        android:inputType="textMultiLine" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- Nomor Telepon -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:hint="@string/nomor_telepon_instansi">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtTeleponInstansi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- Email -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:hint="@string/email_instansi">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtEmailInstansi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ============================= -->
        <!-- DATA PENANGGUNG JAWAB -->
        <!-- ============================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/penanggung_jawab"
                    android:textColor="#424242"
                    android:textSize="18sp"
                    android:textStyle="bold" />


                <!-- Nama Penanggung Jawab -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:hint="@string/nama_penanggung_jawab">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtNamaPenanggungJawab"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- Jabatan -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:hint="@string/jabatan">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtJabatan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- NIK -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:hint="@string/nik_penanggung_jawab">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtNikPenanggungJawab"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="16" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- Nomor HP -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:hint="@string/nomor_hp_penanggung_jawab">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtNoHp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ============================= -->
        <!-- DETAIL PERMOHONAN -->
        <!-- ============================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_permohonan"
                    android:textColor="#424242"
                    android:textSize="18sp"
                    android:textStyle="bold" />


                <!-- Tujuan Pemanfaatan Data -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:hint="@string/tujuan_pemanfaatan_data">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtTujuanPemanfaatan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lines="4"
                        android:gravity="top"
                        android:inputType="textMultiLine" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- Data yang Dibutuhkan -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:hint="@string/data_yang_dibutuhkan">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtDataDibutuhkan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lines="4"
                        android:gravity="top"
                        android:inputType="textMultiLine" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- Keterangan -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:hint="@string/keterangan">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtKeterangan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lines="4"
                        android:gravity="top"
                        android:inputType="textMultiLine" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ============================= -->
        <!-- DOKUMEN PERSYARATAN -->
        <!-- ============================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dokumen_persyaratan"
                    android:textColor="#424242"
                    android:textSize="18sp"
                    android:textStyle="bold" />


                <!-- Surat Permohonan -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUploadFormSuratPindah"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/upload_surat_permohonan_instansi"
                    android:textAllCaps="false"
                    app:icon="@android:drawable/ic_menu_upload" />

                <TextView
                    android:id="@+id/tvSuratPelayanan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/belum_ada_file"
                    android:textColor="#757575"
                    android:textSize="12sp" />


                <!-- Identitas Penanggung Jawab -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUploadKTP"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/upload_ktp_penanggung_jawab"
                    android:textAllCaps="false"
                    app:icon="@android:drawable/ic_menu_upload" />

                <TextView
                    android:id="@+id/tvKTP"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/belum_ada_file"
                    android:textColor="#757575"
                    android:textSize="12sp" />


                <!-- Surat Tugas -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUploadSuratTugas"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/upload_surat_tugas"
                    android:textAllCaps="false"
                    app:icon="@android:drawable/ic_menu_upload" />

                <TextView
                    android:id="@+id/tvSuratTugas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/belum_ada_file"
                    android:textColor="#757575"
                    android:textSize="12sp" />


                <!-- Legalitas Instansi -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUploadLegalitas"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/upload_dokumen_legalitas_instansi"
                    android:textAllCaps="false"
                    app:icon="@android:drawable/ic_menu_upload" />

                <TextView
                    android:id="@+id/tvLegalitas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/belum_ada_file"
                    android:textColor="#757575"
                    android:textSize="12sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ============================= -->
        <!-- BUTTON KIRIM -->
        <!-- ============================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKirim"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:text="@string/kirim_pengajuan"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            app:cornerRadius="12dp" />

    </LinearLayout>

</ScrollView>