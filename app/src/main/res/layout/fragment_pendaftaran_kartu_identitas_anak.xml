<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="@color/background"
android:fillViewport="true"
tools:context=".ui.pelayanan.PendaftaranKartuIdentitasAnakFragment">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- ========================= -->
    <!-- HEADER -->
    <!-- ========================= -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pendaftaran"
        android:textColor="@color/primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/kartu_identitas_anak"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/lengkapi_data_anak_dan_dokumen_persyaratan_untuk_mengajukan_kia"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- ========================= -->
    <!-- DATA ANAK -->
    <!-- ========================= -->

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.SiLancar.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/data_anak"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />


            <!-- Nama Anak -->

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/nama_lengkap_anak">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtNamaAnak"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- NIK Anak -->

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/nik_anak">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtNikAnak"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="16" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- Tempat Lahir -->

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/tempat_lahir">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtTempatLahir"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- Tanggal Lahir -->

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/tanggal_lahir">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtTanggalLahir"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:inputType="none" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Jenis Kelamin -->
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/jenis_kelamin"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                />

            <RadioGroup
                android:id="@+id/rgJenisKelamin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rbLaki"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/laki" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rbPerempuan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/perempuan" />
            </RadioGroup>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ========================= -->
    <!-- DATA ORANG TUA / WALI -->
    <!-- ========================= -->

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.SiLancar.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/data_orang_tua_wali"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />


            <!-- Nama Ayah -->

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/nama_lengkap_ayah">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtNamaAyah"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- NIK Ayah -->

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/nik_ayah">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtNikAyah"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="16" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- Nama Ibu -->

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/nama_lengkap_ibu">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtNamaIbu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- NIK Ibu -->

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/nik_ibu">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtNikIbu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="16" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- ========================= -->
    <!-- DOKUMEN PERSYARATAN -->
    <!-- ========================= -->

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.SiLancar.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dokumen_persyaratan"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/pastikan_dokumen_yang_diunggah_dapat_dibaca_dengan_jelas"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />


            <!-- Akta Kelahiran -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUploadAktaKelahiran"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/upload_akta_kelahiran"
                android:textAllCaps="false"
                app:icon="@android:drawable/ic_menu_upload"
                app:iconTint="@color/primary" />

            <TextView
                android:id="@+id/tvAktaKelahiran"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/belum_ada_file"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />


            <!-- KK -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUploadKK"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/upload_kk"
                android:textAllCaps="false"
                app:icon="@android:drawable/ic_menu_upload"
                app:iconTint="@color/primary" />

            <TextView
                android:id="@+id/tvKK"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/belum_ada_file"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />


            <!-- KTP Ayah -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUploadKtpAyah"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/upload_ktp_ayah"
                android:textAllCaps="false"
                app:icon="@android:drawable/ic_menu_upload"
                app:iconTint="@color/primary" />

            <TextView
                android:id="@+id/tvKTPAyah"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/belum_ada_file"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />


            <!-- KTP Ibu -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUploadKtpIbu"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/upload_ktp_ibu"
                android:textAllCaps="false"
                app:icon="@android:drawable/ic_menu_upload"
                app:iconTint="@color/primary" />

            <TextView
                android:id="@+id/tvKTPIbu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/belum_ada_file"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />


            <!-- Pas Foto -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUploadPasFoto"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/upload_pas_foto_anak"
                android:textAllCaps="false"
                app:icon="@android:drawable/ic_menu_camera"
                app:iconTint="@color/primary" />

            <TextView
                android:id="@+id/tvPasFotoAnak"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/wajib_sesuai_ketentuan_layanan"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- ========================= -->
    <!-- PERNYATAAN -->
    <!-- ========================= -->

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.SiLancar.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <CheckBox
                android:id="@+id/cbPersetujuan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/saya_menyatakan_bahwa_data_dan_dokumen_yang_saya_berikan_adalah_benar_dan_dapat_dipertanggungjawabkan"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- ========================= -->
    <!-- BUTTON KIRIM -->
    <!-- ========================= -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnKirim"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:text="@string/kirim_pengajuan"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        app:cornerRadius="12dp" />

</LinearLayout>

</androidx.core.widget.NestedScrollView>
