<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_navigation"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.silancarapps.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_pendaftaranKKFragment"
            app:destination="@id/pendaftaranKKFragment" />
        <action
            android:id="@+id/action_homeFragment_to_pendaftaranKTPFragment"
            app:destination="@id/pendaftaranKTPFragment" />
        <action
            android:id="@+id/action_homeFragment_to_pendaftaranAktaKelahiranFragment"
            app:destination="@id/pendaftaranAktaKelahiranFragment" />
        <action
            android:id="@+id/action_homeFragment_to_registerActivity"
            app:destination="@id/registerActivity" />
        <action
            android:id="@+id/action_homeFragment_to_loginActivity"
            app:destination="@id/loginActivity" />
        <action
            android:id="@+id/action_homeFragment_to_pendaftaranAktaKematianFragment"
            app:destination="@id/pendaftaranAktaKematianFragment" />
        <action
            android:id="@+id/action_homeFragment_to_pendaftaranSuratPindahFragment"
            app:destination="@id/pendaftaranSuratPindahFragment" />
        <action
            android:id="@+id/action_homeFragment_to_pendaftaranKartuIdentitasAnakFragment"
            app:destination="@id/pendaftaranKartuIdentitasAnakFragment" />
        <action
            android:id="@+id/action_homeFragment_to_pendaftaranPelayananPemanfaatanDataFragment"
            app:destination="@id/pendaftaranPelayananPemanfaatanDataFragment" />
    </fragment>

    <fragment
        android:id="@+id/pendaftaranKKFragment"
        android:name="com.example.silancarapps.ui.pelayanan.PendaftaranKKFragment"
        android:label="Pendaftaran Kartu Keluarga"
        tools:layout="@layout/fragment_pendaftaran_k_k" />

    <fragment
        android:id="@+id/pendaftaranKTPFragment"
        android:name="com.example.silancarapps.ui.pelayanan.PendaftaranKTPFragment"
        android:label="Pendaftaran Kartu Tanda Penduduk"
        tools:layout="@layout/fragment_pendaftaran_k_t_p" />

    <fragment
        android:id="@+id/pendaftaranAktaKelahiranFragment"
        android:name="com.example.silancarapps.ui.pelayanan.PendaftaranAktaKelahiranFragment"
        android:label="Pendaftaran Akta Kelahiran"
        tools:layout="@layout/fragment_pendaftaran_akta_kelahiran" />

    <fragment
        android:id="@+id/pendaftaranAktaKematianFragment"
        android:name="com.example.silancarapps.ui.pelayanan.PendaftaranAktaKematianFragment"
        android:label="Pendaftaran Akta Kematian"
        tools:layout="@layout/fragment_pendaftaran_akta_kematian" />

    <fragment
        android:id="@+id/riwayatFragment"
        android:name="com.example.silancarapps.ui.riwayat.RiwayatKKFragment"
        android:label="Riwayat Pendaftaran"
        tools:layout="@layout/fragment_riwayat" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.silancarapps.ui.profile.ProfileFragment"
        android:label="Profil"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.silancarapps.ui.settings.SettingsFragment"
        android:label="Pengaturan"
        tools:layout="@layout/fragment_settings" />

    <activity
        android:id="@+id/loginActivity"
        android:name="com.example.silancarapps.ui.auth.LoginActivity"
        android:label="Login Account"
        tools:layout="@layout/activity_login" />

    <activity
        android:id="@+id/splashActivity"
        android:name="com.example.silancarapps.ui.splash.SplashActivity"
        android:label="Welcome at SiLancar"
        tools:layout="@layout/activity_splash" />

    <activity
        android:id="@+id/registerActivity"
        android:name="com.example.silancarapps.ui.auth.RegisterActivity"
        android:label="Register Account"
        tools:layout="@layout/activity_register" />

    <fragment
        android:id="@+id/pendaftaranSuratPindahFragment"
        android:name="com.example.silancarapps.ui.pelayanan.PendaftaranSuratPindahFragment"
        android:label="Pendaftaran Surat Pindah / Datang Provinsi dan Kabupaten"
        tools:layout="@layout/fragment_pendaftaran_surat_pindah" />
    <fragment
        android:id="@+id/pendaftaranKartuIdentitasAnakFragment"
        android:name="com.example.silancarapps.ui.pelayanan.PendaftaranKartuIdentitasAnakFragment"
        android:label="Pendaftaran Kartu Identitas Anak"
        tools:layout="@layout/fragment_pendaftaran_kartu_identitas_anak" />
    <fragment
        android:id="@+id/pendaftaranPelayananPemanfaatanDataFragment"
        android:name="com.example.silancarapps.ui.pelayanan.PendaftaranPelayananPemanfaatanDataFragment"
        android:label="Pendaftaran Pelayanan Pemanfaatan Data"
        tools:layout="@layout/fragment_pendaftaran_pelayanan_pemanfaatan_data" />

</navigation>
