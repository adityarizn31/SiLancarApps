<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SiLancarApps" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Main colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
    </style>

    <style name="Theme.SiLancarApps" parent="Base.Theme.SiLancarApps" />

    <!-- Rounded Image Style -->
    <style name="ShapeAppearanceOverlay.App.CornerSize50Percent" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <!-- Custom Outlined Button -->
    <style name="Widget.SiLancar.Button.Rounded" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
    </style>

    <!-- Custom Card Style -->
    <style name="Widget.SiLancar.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
    </style>
</resources>
